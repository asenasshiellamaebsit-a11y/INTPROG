//SWITCH STATEMENT
<?php
$color = "white";

switch ($color) {
    case "red":
    case "orange":
    case "yellow":
        echo "Warm color";
        break;
    case "blue":
    case "white":
    case "green":
        echo "Cool color!";
        break;
    default:
        echo "Neutral color";
        break;
}
?>
